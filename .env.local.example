# Required — get from mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.example

# Optional — customize map style
# Defaults to mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# Backend API base URL
# Defaults to http://localhost:3001 in development
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional — error monitoring
# NEXT_PUBLIC_SENTRY_DSN=

# Optional — WebSocket URL for real-time updates
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/network
